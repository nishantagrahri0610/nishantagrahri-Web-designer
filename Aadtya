  <div class="hindi-name">आदित्य हैंडलूम</div>
  <p class="tagline">Wholesale Readymade Clothing at the Best Rates</p>
  <p class="loc-line">📍 Henry Bazar, Motihari, East Champaran, Bihar</p>
  <a href="#location" class="cta-btn">Get Directions</a>
</section>

