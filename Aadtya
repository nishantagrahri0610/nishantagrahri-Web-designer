  <div class="grid3">
    <div class="feature-item"><div class="icon">💰</div><div class="label">Genuine Wholesale Rates</div></div>
    <div class="feature-item"><div class="icon">🧵</div><div class="label">Wide Variety</div></div>
    <div class="feature-item"><div class="icon">📦</div><div class="label">Bulk Orders Welcome</div></div>
  </div>
</section>

<section class="location" id="location">
  <h2>Visit Our Store</h2>
  <p>Henry Bazar, Motihari, East Champaran, Bihar</p>
  <a href="https://www.google.com/maps/search/?api=1&amp;query=Henry+Bazar+Motihari+East+Champaran+Bihar" target="_blank" class="cta-btn">Get Directions on Google Maps</a>
</section>

<footer>
  <p>&copy; 2026 Aditya Handloom — Founder: Tinku G</p>
  <p class="contact-note">📞 Add your phone / WhatsApp number here</p>
</footer>

</body>
</html>